<div class="tiles">{% for t in teams %}{% set l = t.slug | local %}<a class="tile" href="/teams/{{ t.slug }}/" style="--c1:{{ t.c1 | safeBg }};--c2:{{ t.c2 }};--on:#ffffff"><span class="city">{{ t.city }}</span><b>{{ t.name }}</b><span class="chn">{{ l.short }}</span>{% if l.fdsn %}<span class="tag new">New home</span>{% endif %}{% if l.status == 'unconfirmed' %}<span class="tag unc">Unconfirmed</span>{% endif %}</a>{% endfor %}</div>
