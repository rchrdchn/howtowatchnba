<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light"><script>document.documentElement.classList.add("js")</script>
{% set st = title | seoTitle %}{% set sd = description | seoDesc %}{% set ogimg = page.url | ogImage %}<title>{{ st }}</title><meta name="description" content="{{ sd }}"><link rel="canonical" href="{{ site.url }}{{ page.url }}"><meta name="theme-color" content="#ff4f5e">
<link rel="icon" href="/favicon.svg" type="image/svg+xml"><link rel="manifest" href="/site.webmanifest"><link rel="alternate" type="application/rss+xml" title="{{ site.name }}: local TV checks" href="/feed.xml"><link rel="help" type="text/plain" href="/llms.txt" title="llms.txt">
<link rel="preload" href="/assets/fonts/bricolage-latin.woff2" as="font" type="font/woff2" crossorigin>
<meta property="og:site_name" content="{{ site.name }}"><meta property="og:title" content="{{ st }}"><meta property="og:description" content="{{ sd }}"><meta property="og:type" content="website"><meta property="og:url" content="{{ site.url }}{{ page.url }}"><meta property="og:image" content="{{ ogimg }}"><meta property="og:image:width" content="1200"><meta property="og:image:height" content="630"><meta property="og:image:alt" content="{{ st }}"><meta property="og:locale" content="en_US">
<meta name="twitter:card" content="summary_large_image"><meta name="twitter:title" content="{{ st }}"><meta name="twitter:description" content="{{ sd }}"><meta name="twitter:image" content="{{ ogimg }}">
{% if noindex %}<meta name="robots" content="noindex">{% else %}<script type="application/ld+json">{{ { url: page.url, title: title, description: description, list: list, kind: kind, faqs: faqs, date: (page.date if (kind == 'NewsArticle' or kind == 'Article') else null), author: author, games: games, teamsMentioned: teamsMentioned, t: t if (t and t.abbr) else null } | pageGraph | safe }}</script>{% endif %}
<link rel="stylesheet" href="/assets/style.css?v={{ build.v }}">
{% if teamStyle %}<style>:root{ {{ teamStyle | safe }} }</style>{% endif %}
</head><body><a class="skip" href="#main">Skip to content</a>
<div class="topbar" id="topbar"><div class="wrap"><header class="top"><a class="logo" href="/" aria-label="{{ site.name }} home"><span class="dot" aria-hidden="true">TV</span><span>howtowatch<em>nba</em></span></a>
<nav id="mainnav" aria-label="Main">{% set nav = [["/tonight/","Tonight"],["/teams/","Teams"],["/guides/","Guides"],["/moved/","Where Every Team Moved"],["/blackouts/","Blackout checker"],["/which-night/","Which night"]] %}{% for n in nav %}<a href="{{ n[0] }}"{% if page.url == n[0] %} aria-current="page"{% endif %}>{{ n[1] }}</a>{% endfor %}<a class="nav-adv" href="/advertise/"{% if page.url == '/advertise/' %} aria-current="page"{% endif %}>Advertise</a></nav><div class="hcta"><a class="adv" href="/advertise/"{% if page.url == '/advertise/' %} aria-current="page"{% endif %}>Advertise</a><a class="nlb" href="{{ site.newsletterUrl }}" target="_blank" rel="noopener">Free email</a></div><button type="button" class="burger" id="burger" aria-label="Menu" aria-expanded="false" aria-controls="mainnav"><span class="bars" aria-hidden="true"><i></i><i></i><i></i></span></button></header></div></div>
<main id="main">{{ content | safe }}</main>
<div class="wrap fband">{% include "newsletter.njk" %}</div>
<footer class="foot"><div class="wrap">
<div class="ftop">
<div class="fbrand"><a class="logo" href="/" aria-label="{{ site.name }} home"><span class="dot" aria-hidden="true">TV</span><span>howtowatch<em>nba</em></span></a>
<p class="ftag">Your team moved channels. <span>Here's where.</span></p>
<p class="fmail"><a href="mailto:{{ site.email }}">{{ site.email }}</a><button type="button" class="fcopy ecopy" data-email="{{ site.email }}" aria-label="Copy email address">Copy</button></p>
<a class="fadv" href="/advertise/">Advertise with us →</a></div>
<nav class="fl" aria-label="Tools"><h3>Tools</h3><a href="/tonight/">Tonight's games</a><a href="/guides/">Guides</a><a href="/news/">News: tonight and scores</a><a href="/blackouts/">League Pass blackout checker</a><a href="/moved/">Where Every Team Moved</a><a href="/which-night/">Which night is whose</a><a href="/teams/">All 30 teams</a><a href="/tools/cheapest-way-to-watch-your-team/">Cheapest way to watch your team</a></nav>
<nav class="fl" aria-label="Site"><h3>Site</h3><a href="/about/">About &amp; sources</a><a href="/contact/">Contact</a><a href="/advertise/">Advertise</a><a href="/privacy/">Privacy</a><a href="/sitemap.xml">Sitemap</a></nav>
</div>
<div class="fteams">{% for conf in ["East","West"] %}<nav class="fconf fc-{{ conf | lower }}" aria-label="{{ conf }} teams"><h3>{{ conf }}<span>15 teams</span></h3><div class="fchips">{% for t in teams %}{% if t.conf == conf %}<a href="/teams/{{ t.slug }}/" style="--c1:{{ t.c1 | safeBg }};--c2:{{ t.c2 }}"><i aria-hidden="true">{{ t.abbr }}</i><span>{{ t.name }}</span></a>{% endif %}{% endfor %}</div></nav>{% endfor %}</div>
<div class="fbar"><p class="legal">Local channels hand-checked {{ site.localChecked }} from team, station and trade-press sources; anything we could not confirm is marked unconfirmed. Schedules and national TV refresh nightly. Channels can change, so confirm with your provider. Not affiliated with the NBA, any team or broadcaster.</p><p class="copy">© {{ build.year }} {{ site.name }}</p></div>
</div></footer>
{% if site.cfAnalyticsToken %}<script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "{{ site.cfAnalyticsToken }}"}'></script>{% else %}<!-- Cloudflare Web Analytics: set site.cfAnalyticsToken in src/_data/site.json to enable -->{% endif %}
<script defer src="/assets/site.js?v={{ build.v }}"></script>
</body></html>
