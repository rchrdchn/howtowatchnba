<section class="band" id="newsletter" aria-labelledby="nlh"><div style="flex:1 1 280px"><h2 id="nlh">One email a week. Your team, every channel.</h2><p>Every Sunday: the week's games for your team and exactly where each one airs. Free.</p></div>
{% if site.newsletterUrl %}<a class="btn dark" href="{{ site.newsletterUrl }}" target="_blank" rel="noopener">Subscribe free →</a>{% else %}<form class="nlf" onsubmit="return false" aria-label="Newsletter signup (opening soon)"><label class="skip" for="nle">Email</label><input id="nle" type="email" placeholder="you@email.com" autocomplete="email"><button type="submit">I'm in</button><p class="msg" role="status" hidden>Thanks! Signups open the week of launch. We haven't saved your email yet.</p></form>{% endif %}</section>
